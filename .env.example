# Generate unique values for each local deployment; never commit the resulting .env.
MYSQL_DATABASE=kwantuhub
MYSQL_USER=kwantuhub
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-hex
MYSQL_PORT=3307

JWT_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000
APP_URL=http://localhost:3000
# Leave empty for direct access. Behind a proxy, list only its IPs/CIDRs, comma-separated.
TRUST_PROXY=

S3_BUCKET=kwantuhub
GARAGE_ACCESS_KEY_ID=GKreplace-with-32-hex-characters
GARAGE_SECRET_ACCESS_KEY=replace-with-64-hex-characters
GARAGE_RPC_SECRET=replace-with-64-hex-characters

# Optional external providers. Leave unset for local-only development.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_API_KEY=
SENDPULSE_API_FROM_EMAIL=
SENDPULSE_API_FROM_NAME=KwantuHub
SENDPULSE_WEBHOOK_TOKEN=

DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

TURNSTILE_SECRET_KEY=
TURNSTILE_MODE=disabled
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_PROVIDER=twilio
SENDPULSE_SMS_SENDER=
