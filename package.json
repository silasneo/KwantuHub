{
  "name": "kwantuhub-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "format": "prettier --write \"{app,components,lib,prisma,scripts,tests,docs}/**/*.{ts,tsx,js,mjs,css,yaml,md}\" README.md prisma.config.ts docker-compose.yml",
    "format:check": "prettier --check \"{app,components,lib,prisma,scripts,tests,docs}/**/*.{ts,tsx,js,mjs,css,yaml,md}\" README.md prisma.config.ts docker-compose.yml",
    "test": "vitest run",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:visual": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
